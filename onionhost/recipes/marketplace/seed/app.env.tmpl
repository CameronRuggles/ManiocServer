# Marketplace instance environment (A23 recipe "marketplace").
# Rendered ONCE by onionhost-recipe from this template on first
# install (the manifest's native_config) into native/app.env on
# the app-data volume, with this machine's values substituted
# (the site title the owner chose in the setup wizard). It is
# the instance's own file afterwards - updates never overwrite
# it, and the owner may edit it (the app container's init reads
# it at every start; platform-managed names in it are ignored).
#
# NO SECRETS LIVE HERE. The database credentials are per-install
# platform records (/etc/onionhost/app-db.env, never packaged);
# the app container's init assembles DATABASE_URL from them and
# exports it - this file deliberately has no DATABASE_URL line.
# The marketplace key file (KEY_FILE_PATH below) and the
# Hidden Trades id file (HT_ID_FILE_PATH below) are per-
# install files the RECIPE provisions: the application
# refuses to start outside its Development profile when
# either is missing - it will not mint replacements, because
# a replaced key orphans every stored TOTP secret and a
# replaced id orphans every pinned terms statement. The
# recipe's provision-secrets step (run by the migrate step
# at every container start) creates each file exactly once,
# mode 0600, and never touches an existing one.

# --- Instance identity -------------------------------------------------
# Stagenet instance. The demo profile is the hosted-stagenet
# shape of the marketplace's HTTPS profile, and it REFUSES
# mainnet even if INSTANCE_NETWORK is edited - a mainnet
# instance needs the production profile and the marketplace's
# own typed acceptance sentence in its config (config.rs), a
# separate launch decision this recipe does not make or bypass.
DEPLOY_PROFILE=demo
INSTANCE_NETWORK=stagenet
SITE_NAME=__SITE_TITLE__
BIND_ADDR=127.0.0.1:8080

# --- Data paths (the app-data volume's native tree) ---------------------
KEY_FILE_PATH=/srv/appdata/native/marketplace.key
HT_ID_FILE_PATH=/srv/appdata/native/marketplace.htid
MEDIA_DIR=/srv/appdata/native/media
MEDIA_WORKER=/srv/appdata/native/media-worker
BLOB_DIR=/srv/appdata/native/blobs

# --- Direct Payments v1 (owner-accepted defaults, 2026-10-16) ----------
PAYMENTS_MAX_BATCH=100
PAYMENTS_MAX_UNUSED_POOL=100
PAYMENTS_LOW_POOL_THRESHOLD=10
PAYMENTS_UNPAID_EXPIRY_HOURS=48
PAYMENTS_OPEN_UNPAID_CAP=3
PAYMENTS_ORDER_RATE_PER_HOUR=10
PAYMENTS_RESET_WARNING_DAYS=30
PAYMENTS_SWEEP_INTERVAL_SECS=900
# Server-side signature checking does not exist in v1 (no
# verifier); 0 is the only honest setting - turning it on would
# reject uploads rather than verify them.
PAYMENTS_SERVER_SIGNATURE_CHECK=0

# --- Retention (the marketplace's spec values) --------------------------
NOTIFICATIONS_READ_RETENTION_DAYS=30
SESSIONS_EXPIRED_RETENTION_DAYS=7
SECURITY_EVENTS_RETENTION_DAYS=30
RETENTION_INTERVAL_SECS=3600
