+// === OnionHost patch: forced encryption ==========================
+// The OnionHost phrase step runs before this page and stores the
+// generated disk phrase, obscured, in GlobalStorage under
+// "onionhostGeneratedPhrase". While that key is present, the
+// generated phrase is the ONLY passphrase an automated install may
+// use: layouts are queued with it regardless of the encrypt
+// widget's state, the widget's own passphrase fields are ignored
+// (and kept hidden, see EncryptWidget), and onLeave() does not
+// overwrite the stored value. Without the key, this module behaves
+// exactly like stock Calamares 3.3.14.
+bool
+ChoicePage::onionhostPhraseDriven() const
+{
+    auto* gs = Calamares::JobQueue::instance()->globalStorage();
+    return gs && gs->contains( QStringLiteral( "onionhostGeneratedPhrase" ) )
+        && !gs->value( QStringLiteral( "onionhostGeneratedPhrase" ) ).toString().isEmpty();
+}
+
+QString
+ChoicePage::effectiveLuksPassphrase() const
+{
+    if ( onionhostPhraseDriven() )
+    {
+        auto* gs = Calamares::JobQueue::instance()->globalStorage();
+        // Calamares::String::obscure() is its own inverse: applying
+        // it to the stored (obscured) value yields the plain phrase.
+        return Calamares::String::obscure(
+            gs->value( QStringLiteral( "onionhostGeneratedPhrase" ) ).toString() );
+    }
+    return m_encryptWidget->passphrase();
+}
