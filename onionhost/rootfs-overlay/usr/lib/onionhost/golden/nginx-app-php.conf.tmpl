# OnionHost golden nginx config for the APP container, PHP runtime
# (slice 6B, DESIGN-v3 A12/A20). Rendered to /etc/onionhost/nginx-app.conf
# by onionhost-generate-configs when the site kind is "app".
#
# One combined sandbox (gate-round recommendation): nginx, PHP-FPM and
# MariaDB are processes in THIS container. The FPM and DB sockets are
# sandbox-internal (/run/*.sock); the ONLY socket that crosses the
# boundary is the edge socket below, in the shared /run/onionhost/web
# directory (terminated by the socat splice app-init starts; nginx
# itself listens on the sandbox loopback - the FIONREAD fix), on the
# same b1.sock name container A's http.sock symlink
# already points at - so A, the torrc and the rotation story are
# unchanged from the static tier.
#
# REMOTE_ADDR is fixed at 127.0.0.1 (gate P3 finding): the edge is a
# unix socket (in production: Tor), there IS no client IP to pass, and
# apps that validate REMOTE_ADDR as an IP (SMF does, fatally) break on
# nginx's literal "unix:" value. Over Tor there is no visitor address
# to leak; a fixed loopback is the honest value.
load_module /usr/lib/nginx/modules/ngx_http_headers_more_filter_module.so;
user www-data;
pid /tmp/nginx.pid;
error_log /dev/stderr notice;
worker_processes 1;
events { worker_connections 256; }
http {
    access_log off;
    server_tokens off;
    more_clear_headers Date;
    # Repo Review 5 E-1: never advertise versions to visitors.
    # PHP's X-Powered-By hands an attacker the exact interpreter
    # version for a targeted exploit; Server is cleared
    # defensively beside it (server_tokens off already keeps it
    # versionless). The FPM pool also sets expose_php = 0.
    more_clear_headers 'X-Powered-By';
    more_clear_headers 'Server';
    # Deanonymization audit R-20: static files on the app tier
    # carry real file mtimes (app installs are timestamped;
    # Last-Modified would publish install/edit timing to every
    # visitor, and ETag is derived from the same mtime+inode).
    # Clear the header and switch ETag off; conditional requests
    # simply get full answers. (The app itself may still set
    # its own caching headers in PHP - that is the app's voice,
    # not the filesystem's.)
    more_clear_headers 'Last-Modified';
    etag off;
    # Generic error bodies (R-20): the stock nginx error page
    # names the stack (e.g. the 502 body when the app is down
    # but nginx is up). Only nginx-generated errors land here;
    # the app's own error pages are untouched.
    error_page 404 @onionhost_notfound;
    error_page 500 502 503 504 @onionhost_error;
    sendfile on;
    # Forum-class apps accept uploads; the app data volume's quota is
    # the real bound, this just keeps single requests sane.
    client_max_body_size 32m;
    # Edge reads and FIONREAD (the serving-path fix, two parts):
    #
    # nginx must never read a visitor request from the host-backed
    # edge socket directly. When one of its reads fills the offered
    # buffer exactly, ngx_readv_chain() calls ioctl(FIONREAD) to
    # size the remainder; the gVisor Sentry answers ENOTTY for
    # host-file-backed endpoints, and nginx treats that as a fatal
    # connection error (the error log shows 'ioctl(FIONREAD) failed
    # (25: Inappropriate ioctl for device)' on the connections it
    # kills). Two distinct reads can fill exactly: the header read
    # (client_header_buffer_size, 1k in the stock build -
    # the original cliff, hit by any request whose first flight
    # exceeded it), and the request-body reader's final read, which
    # it caps at exactly the remaining Content-Length - so ANY body
    # arriving in more than one flight fills it, and every real Tor
    # request is multi-flight. No buffer size fixes that read.
    #
    # 1. The edge socket is therefore terminated by the socat
    #    splice app-init starts; nginx listens on the sandbox
    #    loopback (127.0.0.1:18080, the platform edge port), whose
    #    Sentry-native TCP endpoints implement FIONREAD properly.
    # 2. These buffers, sized to the largest body this server
    #    accepts, keep the header read from ever filling even on
    #    a leg whose FIONREAD regressed. They are allocated per
    #    request and only touched as data arrives, so the caps
    #    cost no resident memory on small requests.
    client_header_buffer_size 32m;
    client_body_buffer_size 32m;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    server {
        listen 127.0.0.1:18080;
        root /srv/appdata/www;
        index index.php index.html index.htm;

        location / {
            try_files $uri $uri/ =404;
        }

        location ~ \.php$ {
            try_files $uri =404;
            include /etc/nginx/fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param REMOTE_ADDR 127.0.0.1;
            fastcgi_pass unix:/run/php-fpm.sock;
        }

        # App data that must never be web-readable: the platform's
        # own marker/secret files if an owner drops them in the
        # docroot by mistake. (The DB credentials file itself never
        # lives in the docroot - it is mounted at /etc/onionhost/.)
        location ~* /\.(onionhost|env|git) {
            deny all;
        }

        # Generic error bodies (R-20): one plain sentence each,
        # no server name, no version, no path detail.
        location @onionhost_notfound {
            default_type text/plain;
            return 404 "Not found.\n";
        }
        location @onionhost_error {
            default_type text/plain;
            return 503 "This site is not available right now.\n";
        }

        # Recipe seam (A23): a future project-packaged app recipe
        # may ship an nginx overlay fragment; generate-configs
        # renders this include target (empty unless a recipe
        # provides one). Owner-installed apps never need it.
        include /etc/onionhost/nginx-app-extra.conf;
    }
}
