# OnionHost golden nginx config for the APP container, NATIVE runtime
# (slice 6B, DESIGN-v3 A12/A20/A22). Rendered to
# /etc/onionhost/nginx-app.conf by onionhost-generate-configs when the
# site kind is "app" and the runtime is "native".
#
# A native app is an owner-supplied program (the language-neutral
# slot: a static Rust binary is the reference shape) that listens on
# the unix socket named by the ONIONHOST_APP_SOCKET environment
# variable - /run/app.sock - inside this same sandbox. nginx is a
# pure proxy to it; the app owns its whole URL space. Only the edge
# listener below crosses the container boundary (see the PHP
# template's header for the wiring story).
#
# proxy_pass syntax (gate P4 finding): the colon before the URI part
# matters - "http://unix:/run/app.sock:/" - a slash there makes nginx
# treat it as part of the socket path and answer 502.
load_module /usr/lib/nginx/modules/ngx_http_headers_more_filter_module.so;
user www-data;
pid /tmp/nginx.pid;
error_log /dev/stderr notice;
worker_processes 1;
events { worker_connections 256; }
http {
    access_log off;
    server_tokens off;
    more_clear_headers Date;
    # Repo Review 5 E-1: never advertise versions to visitors.
    # PHP's X-Powered-By hands an attacker the exact interpreter
    # version for a targeted exploit; Server is cleared
    # defensively beside it (server_tokens off already keeps it
    # versionless). The FPM pool also sets expose_php = 0.
    more_clear_headers 'X-Powered-By';
    more_clear_headers 'Server';
    client_max_body_size 32m;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    server {
        listen unix:/run/onionhost/web/b1.sock;

        location / {
            proxy_pass http://unix:/run/app.sock:/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            # No client address exists to forward (unix/Tor edge);
            # the app sees the same fixed loopback as the PHP tier.
            proxy_set_header X-Forwarded-For 127.0.0.1;
            proxy_set_header X-Real-IP 127.0.0.1;
        }

        # Recipe seam (A23): see the PHP template - an optional
        # overlay fragment for future packaged recipes, rendered
        # empty unless a recipe provides one.
        include /etc/onionhost/nginx-app-extra.conf;
    }
}
