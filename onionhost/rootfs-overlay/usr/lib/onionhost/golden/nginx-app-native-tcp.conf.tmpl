# OnionHost golden nginx config for the APP container, NATIVE runtime,
# TCP variant (A22 + A23 recipe 5). Rendered to
# /etc/onionhost/nginx-app.conf by onionhost-generate-configs INSTEAD
# of nginx-app-native.conf.tmpl when the installed native recipe
# declares manifest "native_serve": {"type": "tcp", "port": N} - the
# application binds TCP on the sandbox loopback only (it has no unix
# socket). The edge socket is terminated by the socat splice
# app-init starts (nginx must not read the host-backed edge socket
# itself - the FIONREAD fix, told in full at the buffer sizing
# below), which hands connections to nginx on the sandbox loopback;
# nginx proxies to the app. The port is substituted from the
# manifest at render time (__APP_TCP_PORT__). Everything else is
# the native variant's contract verbatim: the app owns its whole
# URL space; only the splice's edge socket crosses the boundary.
load_module /usr/lib/nginx/modules/ngx_http_headers_more_filter_module.so;
user www-data;
pid /tmp/nginx.pid;
error_log /dev/stderr notice;
worker_processes 1;
events { worker_connections 256; }
http {
    access_log off;
    server_tokens off;
    more_clear_headers Date;
    # Repo Review 5 E-1: never advertise versions to visitors.
    # PHP's X-Powered-By hands an attacker the exact interpreter
    # version for a targeted exploit; Server is cleared
    # defensively beside it (server_tokens off already keeps it
    # versionless). The FPM pool also sets expose_php = 0.
    more_clear_headers 'X-Powered-By';
    more_clear_headers 'Server';
    # Deanonymization audit R-20: see the native (unix-socket)
    # template - Last-Modified cleared on the app tier, and
    # nginx-generated errors get a generic body (the stock 502
    # names the stack when the app is down but nginx is up).
    # The app's own responses pass through untouched.
    more_clear_headers 'Last-Modified';
    error_page 500 502 503 504 @onionhost_error;
    client_max_body_size 32m;
    # Edge reads and FIONREAD (the serving-path fix, two parts):
    #
    # nginx must never read a visitor request from the host-backed
    # edge socket directly. When one of its reads fills the offered
    # buffer exactly, ngx_readv_chain() calls ioctl(FIONREAD) to
    # size the remainder; the gVisor Sentry answers ENOTTY for
    # host-file-backed endpoints, and nginx treats that as a fatal
    # connection error (the error log shows 'ioctl(FIONREAD) failed
    # (25: Inappropriate ioctl for device)' on the connections it
    # kills). Two distinct reads can fill exactly: the header read
    # (client_header_buffer_size, 1k in the stock build -
    # the original cliff, hit by any request whose first flight
    # exceeded it), and the request-body reader's final read, which
    # it caps at exactly the remaining Content-Length - so ANY body
    # arriving in more than one flight fills it, and every real Tor
    # request is multi-flight. No buffer size fixes that read.
    #
    # 1. The edge socket is therefore terminated by the socat
    #    splice app-init starts; nginx listens on the sandbox
    #    loopback (127.0.0.1:18080, the platform edge port), whose
    #    Sentry-native TCP endpoints implement FIONREAD properly.
    # 2. These buffers, sized to the largest body this server
    #    accepts, keep the header read from ever filling even on
    #    a leg whose FIONREAD regressed. They are allocated per
    #    request and only touched as data arrives, so the caps
    #    cost no resident memory on small requests.
    client_header_buffer_size 32m;
    client_body_buffer_size 32m;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    upstream onionhost_app_tcp {
        server 127.0.0.1:__APP_TCP_PORT__;
        keepalive 8;
    }
    server {
        listen 127.0.0.1:18080;

        location / {
            proxy_pass http://onionhost_app_tcp;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            # No client address exists to forward (unix/Tor edge);
            # the app sees the same fixed loopback as the PHP tier.
            proxy_set_header X-Forwarded-For 127.0.0.1;
            proxy_set_header X-Real-IP 127.0.0.1;
            proxy_read_timeout 120s;
        }

        # Generic error body (R-20).
        location @onionhost_error {
            default_type text/plain;
            return 503 "This site is not available right now.\n";
        }

        # Recipe seam (A23): see the PHP template - an optional
        # overlay fragment for future packaged recipes, rendered
        # empty unless a recipe provides one.
        include /etc/onionhost/nginx-app-extra.conf;
    }
}
