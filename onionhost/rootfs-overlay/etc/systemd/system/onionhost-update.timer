[Unit]
Description=OnionHost update schedule (DESIGN-v3 A6/Y7)

[Timer]
# Midnight UTC + up to 24h of per-machine random delay: every
# install checks at its own scattered time, A rebuilds/republishes
# never happen fleet-wide in lockstep, and the repo mirror cannot
# count the fleet by the hour.
OnCalendar=*-*-* 00:00:00 UTC
RandomizedDelaySec=24h
# Deliberately NOT Persistent (deanonymization audit R-13): a
# persistent timer fires a missed run the moment the machine
# powers on, so a box that was off through its window would
# poll the mirror at power-on - exactly the moment an observer
# of the household can already see. A missed window simply
# waits for the next one; update freshness is not worth a
# power-on-timed signal.
Unit=onionhost-update.service

[Install]
WantedBy=timers.target
