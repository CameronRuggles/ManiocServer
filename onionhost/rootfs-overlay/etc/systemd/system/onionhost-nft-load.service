[Unit]
Description=OnionHost - load golden nftables table
# The egress table exists before anything that could use the
# network starts (deanonymization audit R-18): network-pre is
# the standard pre-network ordering point, and the three early
# network consumers are named explicitly so the table precedes
# NetworkManager's first connection attempt, chrony's first
# poll, and the display manager's session start. The golden
# ruleset's own default-deny output policy is the containment
# even in any residual window; this ordering closes the window
# itself rather than relying on the policy to cover it. The
# rig's boot pcap (ISO-BUILD-LOG rig list) is the proof.
After=local-fs.target network-pre.target
Wants=network-pre.target
Before=onionhost-nft-gate.service onionhost-a.service NetworkManager.service chrony.service lightdm.service

[Service]
Type=oneshot
# Idempotent load: `nft -f` over an already-loaded table would append
# duplicate rules and the gate would (correctly) report a mismatch
# forever. Deleting first makes a reload converge to exactly the
# golden table - this delete+load pair is also what a "Repair" does.
ExecStart=/bin/sh -c 'nft delete table inet onionhost 2>/dev/null || true; exec nft -f /usr/lib/onionhost/golden/nft-golden.nft'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
